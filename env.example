###############################################################################
# ENVIRONMENT VARIABLE TEMPLATE
#
# This file provides *placeholders* for all environment variables required
# by the Snowflake Data Engineering Template repository.
#
# 👉 INSTRUCTIONS:
# 1. COPY this file and rename the copy to `.env`
#       cp env.example .env
#
# 2. FILL IN REAL VALUES inside `.env`
#
# 3. DO NOT COMMIT `.env` to Git (it is ignored in .gitignore)
#
# 4. The Python application (connector.py, full_pipeline.py, Prefect)
#    will automatically load `.env` using python-dotenv.
#
# 5. Values here are examples only — they are NOT valid for production.
###############################################################################


##############################################
# Environment Selection
##############################################
# Controls which YAML config is used:
#   - config/dev.yaml
#   - config/prod.yaml
#
# Default is "dev" if not supplied.
ENV=dev


##############################################
# Snowflake Credentials
##############################################
# Example account format:
#   xy12345.eu-west-2
#   ab12345.us-east-1
#
# NOTE:
# - Do NOT include https:// or .snowflakecomputing.com
# - Just the account identifier + region.
SNOWFLAKE_ACCOUNT=

# Username for authentication
SNOWFLAKE_USER=

# Password (if using password-based auth)
# ❗ For production, store in a secret manager
SNOWFLAKE_PASSWORD=

# Snowflake role with required privileges:
#   e.g. SYSADMIN, TRANSFORMER, ANALYST
SNOWFLAKE_ROLE=

# Virtual warehouse for compute:
#   e.g. COMPUTE_WH, TRANSFORM_WH
SNOWFLAKE_WAREHOUSE=

# Default database
SNOWFLAKE_DATABASE=

# Default schema
SNOWFLAKE_SCHEMA=


##############################################
# Optional: Private Key Authentication
##############################################
# Use instead of SNOWFLAKE_PASSWORD
#
# When enabled, Snowflake will authenticate your user using an RSA keypair.
# - Private key must be generated locally
# - Public key must be registered in Snowflake:
#     ALTER USER <user> SET RSA_PUBLIC_KEY='<public-key>';
#
# Example:
# SNOWFLAKE_PRIVATE_KEY_PATH=./keys/dev_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=mysecretpassphrase
#
# Leave empty if not using keypair auth.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=



##############################################
# Optional: External Stage Credentials
##############################################
# Only needed if you're using S3 / Azure Blob / GCS
# external stages such as:
#   CREATE STAGE my_stage URL='s3://bucket/path/'
#
# For S3 staging via Snowflake COPY:
#
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
#
# Leave blank if not using external cloud storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=


##############################################
# Prefect (Optional)
##############################################
# Used only if running the pipeline via Prefect Cloud
# or Prefect Server deployments.
#
# PREFECT_API_URL: URL of your Prefect workspace
# PREFECT_API_KEY: Authentication token
#
# These are NOT required for local runs.
PREFECT_API_URL=
PREFECT_API_KEY=


###############################################################################
# END OF FILE
#
# Reminder:
# - Commit ONLY env.example
# - DO NOT commit .env
###############################################################################

